{
  "name": "@p10node/graphviz",
  "version": "0.11.1",
  "description": "Graphviz DOT graphs to SVG in the browser or Node, with no WebAssembly, server or dependency",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
