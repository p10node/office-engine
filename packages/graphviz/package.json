  "keywords": [
    "graphviz",
    "dot",
    "graph",
    "diagram",
    "svg"
  ],
  "homepage": "https://github.com/p10node/office-engine/tree/main/packages/graphviz#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/p10node/office-engine.git",
    "directory": "packages/graphviz"
  },
  "publishConfig": {
    "access": "public"
  }
}
