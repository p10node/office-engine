{
  "name": "@p10node/markdown",
  "version": "0.11.0",
  "description": "Markdown to safe HTML with Mermaid, PlantUML and Graphviz code blocks drawn as SVG; no dependency",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "keywords": [
    "markdown",
    "commonmark",
    "gfm",
    "html",
    "mermaid",
    "plantuml",
    "graphviz"
  ],
  "homepage": "https://github.com/p10node/office-engine/tree/main/packages/markdown#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/p10node/office-engine.git",
    "directory": "packages/markdown"
  },
  "publishConfig": {
    "access": "public"
  }
}
