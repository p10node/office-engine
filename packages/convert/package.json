{
  "name": "@p10node/convert",
  "version": "0.1.0",
  "description": "Office files converted on a server without LibreOffice: DOC, XLS, PPT, RTF, OpenDocument, Pages, Keynote, Numbers, Visio, CSV, Markdown, HTML to DOCX / XLSX / PPTX, and documents to text, Markdown, HTML or CSV. A function, a CLI and an HTTP service with Gotenberg's routes; no dependency",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "office-convert": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22",
    "bun": ">=1.3"
  },
  "sideEffects": false,
  "keywords": [
    "docx",
    "xlsx",
    "pptx",
    "doc",
    "xls",
    "ppt",
    "odt",
    "convert",
    "gotenberg",
    "libreoffice",
    "server"
  ],
  "homepage": "https://github.com/p10node/office-engine/tree/main/packages/convert#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/p10node/office-engine.git",
    "directory": "packages/convert"
  },
  "publishConfig": {
    "access": "public"
  }
}
